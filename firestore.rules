rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if the user is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      // Followers and Following subcollections
      match /following/{targetId} {
        allow read: if true;
        // User A writes to their own 'following' list
        allow write: if isOwner(userId);
      }
      
      match /followers/{followerId} {
        allow read: if true;
        // User B (follower) writes to User A's 'followers' list
        // So we allow write if the requester is the one being added (followerId)
        allow write: if isOwner(followerId); 
      }
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      
      // Create: Must be signed in and authorId must match
      allow create: if isSignedIn() 
                   && request.resource.data.authorId == request.auth.uid;
      
      // Update: Allow if author, OR if updating likes/comments count
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        // Allow updating only specific fields (counters)
        // Note: This is a loose rule for simplicity in this architecture. 
        // Ideally, use Cloud Functions or stricter field-level checks.
        (request.resource.data.diff(resource.data).affectedKeys()
         .hasOnly(['likesCount', 'commentsCount']))
      );
      
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
