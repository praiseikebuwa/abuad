rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --------------------------------------------------------------------------
    // Helper functions
    // --------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "user") == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("isAdmin", false) == true
        );
    }

    function isBlockedUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          currentUserDoc().data.get("isBlocked", false) == true ||
          currentUserDoc().data.get("is_blocked", false) == true
        );
    }

    function isVerifiedUser(data) {
      return data.get("isVerified", false) == true || 
             data.get("is_verified", false) == true;
    }

    function getVerificationType(data) {
      return data.get("verificationType", data.get("verification_type", "none"));
    }

    // --------------------------------------------------------------------------
    function isSignedInAndActive() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        !isBlockedUser();
    }

    function isChannelMemberFromDoc(channelDoc) {
      return isSignedIn() && 
        request.auth.uid in channelDoc.get('member_ids', []);
    }

    function canSelfCreateUser(userId) {
      return isSelf(userId) &&
        (
          !("uid" in request.resource.data) ||
          request.resource.data.uid == userId
        ) &&
        (
          !("role" in request.resource.data) ||
          request.resource.data.role in ["student", "user"]
        ) &&
        (
          !("isAdmin" in request.resource.data) ||
          request.resource.data.isAdmin == false
        ) &&
        isVerifiedUser(request.resource.data) == false &&
        getVerificationType(request.resource.data) == 'none';
    }

    function canSelfUpdateUser(userId) {
      return isSelf(userId) &&
        (
          !("uid" in request.resource.data) ||
          request.resource.data.uid == userId
        ) &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        request.resource.data.get('isBlocked', false) == resource.data.get('isBlocked', false) &&
        request.resource.data.get('is_blocked', false) == resource.data.get('is_blocked', false) &&
        isVerifiedUser(request.resource.data) == isVerifiedUser(resource.data) &&
        getVerificationType(request.resource.data) == getVerificationType(resource.data) &&
        // Validate social links
        (
          !('website_url' in request.resource.data) || request.resource.data.website_url is string
        ) &&
        (
          !('facebook_url' in request.resource.data) || request.resource.data.facebook_url is string
        ) &&
        (
          !('twitter_url' in request.resource.data) || request.resource.data.twitter_url is string
        ) &&
        (
          !('instagram_url' in request.resource.data) || request.resource.data.instagram_url is string
        ) &&
        (
          !('linkedin_url' in request.resource.data) || request.resource.data.linkedin_url is string
        ) &&
        (
          !('tiktok_url' in request.resource.data) || request.resource.data.tiktok_url is string
        ) &&
        (
          !('youtube_url' in request.resource.data) || request.resource.data.youtube_url is string
        ) &&
        (
          !('snapchat_url' in request.resource.data) || request.resource.data.snapchat_url is string
        ) &&
        (
          !('github_url' in request.resource.data) || request.resource.data.github_url is string
        ) &&
        (
          !('twitch_url' in request.resource.data) || request.resource.data.twitch_url is string
        );
    }

    function canAdjustFollowCounters() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isSignedInAndActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "followers_count",
          "following_count"
        ]) &&
        (
          !changed.hasAny(["followers_count"]) ||
          (
            request.resource.data.followers_count is int &&
            resource.data.followers_count is int &&
            (
              request.resource.data.followers_count == resource.data.followers_count + 1 ||
              request.resource.data.followers_count == resource.data.followers_count - 1
            )
          )
        ) &&
        (
          !changed.hasAny(["following_count"]) ||
          (
            request.resource.data.following_count is int &&
            resource.data.following_count is int &&
            (
              request.resource.data.following_count == resource.data.following_count + 1 ||
              request.resource.data.following_count == resource.data.following_count - 1
            )
          )
        );
    }

    function canCreatePost(postId) {
      let userData = currentUserDoc().data;
      return isSignedInAndActive() &&
        request.resource.data.author_id == request.auth.uid &&
        request.resource.data.id == postId &&
        isVerifiedUser(request.resource.data) == isVerifiedUser(userData) &&
        getVerificationType(request.resource.data) == getVerificationType(userData) &&
        // Check new fields
        (
          !('hashtags' in request.resource.data) || request.resource.data.hashtags is list
        ) &&
        (
          !('mentions' in request.resource.data) || request.resource.data.mentions is list
        ) &&
        (
          !('visibility' in request.resource.data) || request.resource.data.visibility in ['everyone', 'followers']
        );
    }

    function canUpdateOwnPost() {
      return isSignedInAndActive() &&
        resource.data.author_id == request.auth.uid &&
        request.resource.data.author_id == resource.data.author_id &&
        request.resource.data.id == resource.data.id &&
        isVerifiedUser(request.resource.data) == isVerifiedUser(resource.data) &&
        getVerificationType(request.resource.data) == getVerificationType(resource.data);
    }

    function canUpdatePostEngagement() {
      let diff = request.resource.data.diff(resource.data);
      let affected = diff.affectedKeys();
      
      return isSignedInAndActive() &&
        request.resource.data.author_id == resource.data.author_id &&
        request.resource.data.id == resource.data.id &&
        affected.hasOnly([
          "likes_count",
          "comments_count",
          "repost_count",
          "views_count",
          "poll_data",
          "poll"
        ]) &&
        (
          !affected.hasAny(["likes_count"]) || 
          request.resource.data.likes_count == resource.data.get("likes_count", 0) + 1 ||
          request.resource.data.likes_count == resource.data.get("likes_count", 0) - 1
        ) &&
        (
          !affected.hasAny(["comments_count"]) || 
          request.resource.data.comments_count == resource.data.get("comments_count", 0) + 1 ||
          request.resource.data.comments_count == resource.data.get("comments_count", 0) - 1
        ) &&
        (
          !affected.hasAny(["repost_count"]) || 
          request.resource.data.repost_count == resource.data.get("repost_count", 0) + 1
        ) &&
        (
          !affected.hasAny(["views_count"]) || 
          request.resource.data.views_count == resource.data.get("views_count", 0) + 1
        );
    }

    function canCreateComment() {
      return isSignedInAndActive() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000;
    }

    function canCreateChannel() {
      return isSignedInAndActive() && (
        request.resource.data.member_ids is list &&
        request.auth.uid in request.resource.data.member_ids
      );
    }

    function canUpdateChannelAsMember() {
      return isSignedInAndActive() &&
        isChannelMemberFromDoc(resource.data);
    }

    function canUpdateMessageReactions(channelId) {
      let channel = get(/databases/$(database)/documents/channels/$(channelId));
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let reactionsDiff = request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {}));
      
      return isSignedInAndActive() &&
        isChannelMemberFromDoc(channel.data) &&
        affected.hasOnly(["reactions"]) &&
        reactionsDiff.affectedKeys().hasOnly([request.auth.uid]);
    }

    function canCreateMessage(channelId, messageId) {
      let channel = get(/databases/$(database)/documents/channels/$(channelId));
      return isSignedInAndActive() &&
        isChannelMemberFromDoc(channel.data) &&
        request.resource.data.sender_id == request.auth.uid &&
        request.resource.data.id == messageId;
    }

    function canReadChannelMessages(channelId) {
      let channel = get(/databases/$(database)/documents/channels/$(channelId));
      return isChannelMemberFromDoc(channel.data);
    }

    function isValidStoryViewerUpdate() {
      return isSignedInAndActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewers"]) &&
        request.resource.data.viewers is list &&
        resource.data.viewers is list &&
        !(request.auth.uid in resource.data.viewers) &&
        request.auth.uid in request.resource.data.viewers &&
        request.resource.data.viewers.size() == resource.data.viewers.size() + 1 &&
        request.resource.data.viewers.hasAll(resource.data.viewers);
    }

    function isValidStoryLikeUpdate() {
      return isSignedInAndActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"]) &&
        request.resource.data.likes is list &&
        resource.data.likes is list &&
        !(request.auth.uid in resource.data.likes) &&
        request.auth.uid in request.resource.data.likes &&
        request.resource.data.likes.size() == resource.data.likes.size() + 1 &&
        request.resource.data.likes.hasAll(resource.data.likes);
    }

    function isValidSnapViewUpdate() {
      return isSignedIn() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.user_name == resource.data.user_name &&
        request.resource.data.user_avatar == resource.data.user_avatar &&
        request.resource.data.image_url == resource.data.image_url &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.expires_at == resource.data.expires_at &&
        request.resource.data.viewers is list &&
        resource.data.viewers is list &&
        !(request.auth.uid in resource.data.viewers) &&
        request.auth.uid in request.resource.data.viewers &&
        request.resource.data.viewers.size() == resource.data.viewers.size() + 1 &&
        request.resource.data.viewers.hasAll(resource.data.viewers);
    }

    function canUpdateGroupMemberCountOnly() {
      return isSignedInAndActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["member_count"]) &&
        request.resource.data.member_count is int &&
        resource.data.member_count is int &&
        (
          request.resource.data.member_count == resource.data.member_count + 1 ||
          request.resource.data.member_count == resource.data.member_count - 1
        );
    }

    function canCreateReport() {
      return isSignedIn() &&
        (
          !("reporterId" in request.resource.data) ||
          request.resource.data.reporterId == request.auth.uid
        );
    }


    // --------------------------------------------------------------------------
    // users/{userId}
    // Supports both snake_case (Flutter app) and camelCase (admin/functions).
    // --------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if canSelfCreateUser(userId);
      allow update: if canSelfUpdateUser(userId) || canAdjustFollowCounters();
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(followerId);
        allow update: if false;
      }

      match /following/{followedId} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(userId);
        allow update: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create: if isSignedIn() && request.resource.data.user_id == userId;
        allow update, delete: if isSelf(userId);
      }
    }

    // --------------------------------------------------------------------------
    // snaps/{snapId}
    // --------------------------------------------------------------------------
    match /snaps/{snapId} {
      allow read: if isSignedIn();
      allow create: if isSignedInAndActive() && request.resource.data.user_id == request.auth.uid;
      allow update: if (
        isSignedInAndActive() && resource.data.user_id == request.auth.uid
      ) || isValidSnapViewUpdate();
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // --------------------------------------------------------------------------
    // posts/{postId}
    // --------------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if canCreatePost(postId);
      allow update: if canUpdateOwnPost() || canUpdatePostEngagement();
      allow delete: if isSignedIn() && resource.data.author_id == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if canCreateComment();
        allow update: if isSignedIn() && resource.data.user_id == request.auth.uid;
        allow delete: if isSignedIn() && (
          resource.data.user_id == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.author_id == request.auth.uid
        );
      }

      match /views/{userId} {
        allow read: if isSignedIn();
        allow create: if isSelf(userId);
        allow update, delete: if false;
      }
    }

    function isChannelAdminFromDoc(channelDoc) {
      return isSignedIn() && 
        request.auth.uid in channelDoc.get('admin_ids', [channelDoc.get('created_by', '')]);
    }

    function canUpdateChannel(channelId) {
      let isMember = isChannelMemberFromDoc(resource.data);
      let isAdmin = isChannelAdminFromDoc(resource.data);
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      
      return isAdmin || (
        isMember && 
        affected.hasOnly([
          'unread_counts', 'last_message', 'last_message_time', 
          'streak_count', 'last_snap_time', 'streak_expiry', 
          'member_ids', 'member_names', 'member_avatars', 'verification_types',
          'display_name', 'display_avatar_url'
        ]) &&
        (!affected.hasAny(['member_ids']) || (
          request.resource.data.member_ids is list &&
          resource.data.member_ids is list &&
          request.auth.uid in resource.data.member_ids &&
          !(request.auth.uid in request.resource.data.member_ids) &&
          request.resource.data.member_ids.size() == resource.data.member_ids.size() - 1
        )) &&
        (!affected.hasAny(['display_name', 'display_avatar_url']) || !resource.data.get('restrict_info_updates', false))
      );
    }

    // --------------------------------------------------------------------------
    // channels/{channelId}
    // --------------------------------------------------------------------------
    match /channels/{channelId} {
      allow read: if isChannelMemberFromDoc(resource.data);
      allow create: if canCreateChannel();
      allow update: if canUpdateChannel(channelId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadChannelMessages(channelId);
        allow create: if canCreateMessage(channelId, messageId) && (
          !get(/databases/$(database)/documents/channels/$(channelId)).data.get('restrict_messaging', false) ||
          isChannelAdminFromDoc(get(/databases/$(database)/documents/channels/$(channelId)).data)
        ) && (
          // Type validation
          request.resource.data.type in ['text', 'image', 'location', 'voice', 'giphy']
        ) && (
          // Content or Attachment validation
          (request.resource.data.type == 'text' && request.resource.data.content is string && request.resource.data.content.size() > 0) ||
          (request.resource.data.type == 'image' && request.resource.data.image_url is string) ||
          (request.resource.data.type == 'voice' && request.resource.data.audio_url is string && request.resource.data.duration is int) ||
          (request.resource.data.type == 'giphy' && request.resource.data.image_url is string) ||
          (request.resource.data.type == 'location' && request.resource.data.latitude is float && request.resource.data.longitude is float)
        );
        allow update: if (isSignedIn() && resource.data.sender_id == request.auth.uid) || canUpdateMessageReactions(channelId);
        allow delete: if isSignedIn() && resource.data.sender_id == request.auth.uid;
      }
    }

    // --------------------------------------------------------------------------
    // stories/{storyId}
    // --------------------------------------------------------------------------
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedInAndActive() &&
        request.resource.data.author_id == request.auth.uid &&
        request.resource.data.id == storyId;
      allow update: if (
        isSignedInAndActive() && resource.data.author_id == request.auth.uid
      ) || isValidStoryViewerUpdate() || isValidStoryLikeUpdate();
      allow delete: if isSignedIn() && resource.data.author_id == request.auth.uid;
    }

    // --------------------------------------------------------------------------
    // events/{eventId}
    // --------------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedInAndActive() && request.resource.data.organizer_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.organizer_id == request.auth.uid;

      match /attendees/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(userId);
        allow update: if false;
      }
    }

    // --------------------------------------------------------------------------
    // groups/{groupId}
    // --------------------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedInAndActive() && request.resource.data.creator_id == request.auth.uid;
      allow update: if (
        isSignedIn() && resource.data.creator_id == request.auth.uid
      ) || canUpdateGroupMemberCountOnly();
      allow delete: if isSignedIn() && resource.data.creator_id == request.auth.uid;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(memberId);
        allow update: if false;
      }
    }

    // --------------------------------------------------------------------------
    // resources/{resourceId}
    // --------------------------------------------------------------------------
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedInAndActive() && request.resource.data.uploader_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uploader_id == request.auth.uid;
    }

    // --------------------------------------------------------------------------
    // marketplace_items/{itemId}
    // --------------------------------------------------------------------------
    match /marketplace_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedInAndActive() && 
        request.resource.data.seller_id == request.auth.uid &&
        (
          !('images' in request.resource.data) || request.resource.data.images is list
        ) &&
        request.resource.data.title is string &&
        (request.resource.data.price is int || request.resource.data.price is float);
      allow update, delete: if isSignedIn() && resource.data.seller_id == request.auth.uid;
    }

    // --------------------------------------------------------------------------
    // announcements/{announcementId}
    // Admin managed content, app can read only.
    // --------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // --------------------------------------------------------------------------
    // reports/{reportId}
    // App users submit, admins review.
    // --------------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if false;
      allow create: if canCreateReport();
      allow update, delete: if false;
    }

    // --------------------------------------------------------------------------
    // presence/{userId}
    // --------------------------------------------------------------------------
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSelf(userId);
    }

    // --------------------------------------------------------------------------
    // notifications/{notificationId}
    // Supports both `user_id` and legacy `recipient_id`.
    // --------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.recipient_id == request.auth.uid
      );
      allow create: if isSignedIn() &&
        (
          "user_id" in request.resource.data ||
          "recipient_id" in request.resource.data
        ) &&
        (
          !("sender_id" in request.resource.data) ||
          request.resource.data.sender_id == request.auth.uid
        );
      allow update: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.recipient_id == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.recipient_id == request.auth.uid
      );
    }

    // --------------------------------------------------------------------------
    // Global admin override (Moved to bottom)
    // --------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
