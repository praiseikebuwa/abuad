rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    function isPdf() {
      return request.resource.contentType.matches('application/pdf');
    }
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    // Profile Images
    match /profile_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && request.resource.size < 20 * 1024 * 1024; // 20MB limit
    }

    // Post Media (Images & Videos)
    match /post_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && request.resource.size < 20 * 1024 * 1024; // 20MB
    }

    match /post_videos/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isVideo() && request.resource.size < 100 * 1024 * 1024; // 100MB
    }

    // Story Media (Images & Videos)
    match /stories/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && 
                      (isImage() || isVideo()) && 
                      request.resource.size < 50 * 1024 * 1024; // 50MB for videos
    }

    // Snaps (Images)
    match /snaps/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && 
                      isImage() && 
                      request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Chat Snap Media
    match /chat_snaps/{channelId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
                      isImage() && 
                      request.resource.size < 10 * 1024 * 1024;
    }

    // Chat Media
    match /chat_media/{channelId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
                      (isImage() || isVideo()) && 
                      request.resource.size < 20 * 1024 * 1024;
    }

    // Chats (Legacy/Internal path)
    match /chats/{channelId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
                      (isImage() || isVideo()) && 
                      request.resource.size < 20 * 1024 * 1024;
    }

    // Chat Audio
    match /chat_audio/{channelId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAudio() && request.resource.size < 10 * 1024 * 1024; // 10MB
    }

    // Event Images
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage(); // Basic check, better if admin/organizer logic enforced in app
    }

    // Marketplace Images
    match /marketplace/{itemId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage();
    }

    // Group Images
    match /groups/{groupId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage();
    }

    // Resources (PDFs, Docs)
    match /resources/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() || isAdmin()) && 
                      request.resource.size < 100 * 1024 * 1024; // 100MB
    }
  }
}
