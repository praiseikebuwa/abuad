{
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/.well-known/$1"
    },
    {
      "source": "/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|facebookexternalhit|whatsapp|twitter|telegram|discord|slack|linkedin|applebot|preview|meta|pinterest|skype|viber).*"
        }
      ],
      "destination": "https://api.abuadapp.com.ng/share/post/:id"
    },
    {
      "source": "/p/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|facebookexternalhit|whatsapp|twitter|telegram|discord|slack|linkedin|applebot|preview|meta|pinterest|skype|viber).*"
        }
