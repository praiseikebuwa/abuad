{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "abuadapp",
                    "appId": "1:597625995805:android:e4fe555553eb3c10237cf4",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "abuadapp",
                    "configurations": {
                        "android": "1:597625995805:android:e4fe555553eb3c10237cf4",
                        "ios": "1:597625995805:ios:8d19a0f7b4bf543f237cf4"
                    }
                }
            }
        }
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "disallowLegacyRuntimeConfig": true,
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ],
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": [
        {
            "site": "abuadapp",
            "public": "hosting/public",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "appAssociation": "AUTO",
            "rewrites": [
                {
                    "source": "/post/**",
                    "function": "postPreview"
                },
                {
                    "source": "/web/**",
                    "destination": "/web/index.html"
                },
                {
                    "source": "/admin/**",
                    "destination": "/admin/index.html"
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "/**",
                    "headers": [
                        {
                            "key": "Cross-Origin-Opener-Policy",
                            "value": "same-origin-allow-popups"
                        }
                    ]
                },
                {
                    "source": "/.well-known/apple-app-site-association",
                    "headers": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                }
            ]
        }
    ]
}
